# Entorno de las pruebas E2E. Copia este archivo a `.env.e2e` y rellénalo.
#
# `.env.e2e` NO se versiona. La forma recomendada de crearlo es `npm run e2e:env`,
# que genera los secretos aleatorios por ti; este ejemplo documenta qué significa
# cada variable.
#
# Nada de aquí toca la base de la aplicación: `lib/testing/e2e-database-guard.ts`
# aborta la ejecución si la base de pruebas coincide con la de la aplicación o si
# no es claramente desechable. Ver docs/pruebas-e2e.md.

# --- Contenedor de PostgreSQL (docker-compose.e2e.yml) ---------------------
E2E_POSTGRES_USER=
E2E_POSTGRES_PASSWORD=
E2E_POSTGRES_DB=

# Cadena de conexión de la base de pruebas. Sin pooler: es PostgreSQL directo,
# así que la usan tanto el runtime como `prisma migrate deploy`.
# El puerto por defecto del contenedor es 55432, no 5432, para no confundirla
# con ningún PostgreSQL que ya tengas levantado.
E2E_DATABASE_URL=

# Permite apuntar a un host que no sea local (p. ej. un contenedor de servicio en
# CI). Solo el valor exacto "true". Aun con permiso, el nombre de la base debe
# contener "e2e", "test" o "prueba": la base por defecto de Supabase se llama
# "postgres" y así un copiar y pegar sigue abortando.
E2E_ALLOW_NONLOCAL=

# --- Servidor bajo prueba --------------------------------------------------
# Puerto distinto del de desarrollo para poder tener las dos cosas levantadas.
# Valor habitual: http://localhost:3100 (lo escribe `npm run e2e:env`).
# Se deja vacío como el resto: una plantilla con valores es una plantilla que
# alguien acabará guardando rellena por encima de la original.
E2E_BASE_URL=

# Secretos propios del entorno de pruebas. Distintos de los de desarrollo: si se
# compartieran, una sesión de pruebas valdría en desarrollo y al contrario.
E2E_BETTER_AUTH_SECRET=
E2E_RATE_LIMIT_HASH_SECRET=
E2E_VIP_TOKEN_HASH_SECRET=

# --- Cuentas ficticias del escenario ---------------------------------------
# Las crea `scripts/e2e-seed.ts` en cada ejecución. Usa el TLD reservado `.test`
# (RFC 2606), que no resuelve: ninguna prueba puede escribir a una persona real.
# La contraseña debe tener al menos 12 caracteres (emailAndPassword.minPasswordLength).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_SALES_EMAIL=
E2E_SALES_PASSWORD=
E2E_CONTENT_EMAIL=
E2E_CONTENT_PASSWORD=
