# Supabase — PostgreSQL (proyecto porton-tfm-dev). Ver docs/arquitectura-backend.md §2.
# DATABASE_URL: pooler en modo Transaction (puerto 6543, `pgbouncer=true`). Runtime.
# DIRECT_URL: pooler en modo Session (puerto 5432) o conexión directa si resuelve
# en tu red. La usan `prisma migrate`/`db push`.
DATABASE_URL=
DIRECT_URL=

# Supabase — API pública del proyecto (Storage privado / cliente supabase-js).
# Uso previsto siempre server-side (sin prefijo NEXT_PUBLIC_).
SUPABASE_URL=

# Claves nuevas (formato sb_publishable_/sb_secret_).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claves legacy (JWT anon/service_role), mantenidas por compatibilidad.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hashes HMAC irreversibles (ver lib/security/hash.ts). *_PREVIOUS es opcional,
# lista separada por comas con claves antiguas durante una ventana de rotación.
RATE_LIMIT_HASH_SECRET=
RATE_LIMIT_HASH_SECRET_PREVIOUS=
VIP_TOKEN_HASH_SECRET=
VIP_TOKEN_HASH_SECRET_PREVIOUS=

# En producción, el contenido isDemo=true no se lista salvo que esta variable
# sea "true". Ver lib/domain/content.ts y docs/modelo-datos.md §3/§6.
#
# Es la variable que hay que RETIRAR cuando la demo deje de hacer falta: sin ella,
# las fichas de ejemplo desaparecen de la web pública sin borrar nada.
# Ver docs/runbook-demo.md §5.
ENABLE_DEMO_CONTENT=

# Cuenta de evaluación de la demo (`npm run demo:seed`). Las dos son opcionales:
# sin ellas se siembra la demo pero no se crea ninguna cuenta con contraseña.
# La contraseña necesita 12 caracteres como mínimo, se entrega SOLO por canal
# privado y se retira del entorno después de ejecutar el sembrado una vez.
# Para desactivar la cuenta al terminar: `npm run demo:clean -- --cuenta`.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Better Auth (ver docs/autenticacion.md). Generar con
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Rotarlo invalida todas las sesiones activas.
BETTER_AUTH_SECRET=
# Origen real desde el que se sirve la app (afecta a si la cookie de sesión
# se marca Secure: solo con https:// o NODE_ENV=production).
BETTER_AUTH_URL=

# Bootstrap del primer usuario ADMIN (`npm run admin:bootstrap`). Retirar
# estas tres variables inmediatamente después de ejecutar el comando una
# única vez: no deben quedar guardadas de forma permanente.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Email transaccional (ver docs/email.md). TODAS son opcionales: sin ellas los
# formularios funcionan igual, no se envía nada y cada intento queda como
# SKIPPED_CONFIG en NotificationLog. La base de datos es la fuente de verdad;
# el correo es un efecto secundario.
#
# SENDGRID_API_KEY + LEADS_FROM_EMAIL: hacen falta LAS DOS para que haya
# transporte real. Con solo la clave, SendGrid rechazaría el envío por falta de
# remitente verificado, así que se considera "sin configurar".
SENDGRID_API_KEY=
LEADS_FROM_EMAIL=
# Destinatarios internos del aviso comercial. Lista separada por comas.
LEADS_NOTIFICATION_TO=
# Acuse de recibo al visitante. Solo el valor exacto "true" lo activa: escribir
# a alguien es una decisión que se toma a propósito, no algo que se herede de un
# valor mal escrito.
SEND_LEAD_ACKNOWLEDGEMENT=
# Base de los enlaces al panel que van en los correos (sin barra final). Es la
# única variable pública del proyecto. Si falta, se usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Plazo de retención de datos de contacto, en meses (1-240). Por defecto 36.
# Solo se usa para IDENTIFICAR candidatos a anonimizar (`npm run privacy:retention`):
# nada se anonimiza automáticamente. El plazo concreto lo tiene que fijar un
# profesional; ver README §Pendientes legales.
DATA_RETENTION_MONTHS=

# Content-Security-Policy. Por defecto se sirve en Report-Only para poder observar
# las violaciones reales antes de bloquear. Ponla en "true" para que bloquee.
# Ver docs/modelo-amenazas.md §7.
CSP_ENFORCE=

# --- Acceso al panel con clave única -----------------------------------------
# Sustituye el par correo + contraseña por una sola clave, sin usuario, en
# /admin/login. Es una decisión explícita del titular; lo que implica está
# documentado en lib/auth/admin-gate.ts y en README §Seguridad.
#
# Sin estas tres variables la pantalla existe pero NO deja entrar: el lado
# seguro. El acceso por credenciales sigue disponible en /admin/login/credenciales.
#
# La clave que se teclea. Mínimo 8 caracteres. Nunca se escribe en el código.
ADMIN_GATE_PASSWORD=
# Cuenta real contra la que se inicia sesión al acertar la clave. Debe existir y
# tener rol ADMIN (se crea con `npm run admin:bootstrap`).
ADMIN_GATE_EMAIL=
# Contraseña de esa cuenta. No se teclea nunca en la pantalla de acceso.
ADMIN_GATE_ACCOUNT_PASSWORD=
